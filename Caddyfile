{
    email {$ACME_EMAIL}
}

{$APP_DOMAIN:actionlog.ru}, www.{$APP_DOMAIN:actionlog.ru} {
    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers delete
                request>uri delete
                resp_headers delete
                user_id delete
            }
        }
    }
    encode gzip

    @api path /api/*
    handle @api {
        reverse_proxy backend:3001
    }

    handle {
        reverse_proxy frontend:80
    }
}
