<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{subject}}</title>
</head>
<body style="margin:0;background:#f5f7fa;font-family:Arial,sans-serif;color:#263238;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="padding:32px 16px;background:#f5f7fa;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:600px;background:#fff;border-radius:14px;overflow:hidden;box-shadow:0 8px 24px rgba(90,112,184,.12);">
          <tr><td style="padding:22px 28px;background:#5673dc;color:#fff;font-size:20px;font-weight:700;">{{heading}}</td></tr>
          <tr>
            <td style="padding:28px;font-size:15px;line-height:1.6;">
              <p style="margin:0 0 16px;">{{greeting}}</p>
              <p style="margin:0 0 10px;">{{message}}</p>
              <p style="margin:0 0 24px;color:#69758c;font-size:13px;">{{actor}}</p>
              <a href="{{projectsUrl}}" style="display:inline-block;padding:11px 18px;border-radius:8px;background:#5673dc;color:#fff;text-decoration:none;font-weight:600;">{{action}}</a>
            </td>
          </tr>
          <tr><td style="padding:16px 28px;border-top:1px solid #edf0f6;color:#90a0b7;font-size:12px;">{{appName}} · {{year}}</td></tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
